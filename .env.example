# ==============================================================================
# قالب متغيرات البيئة لبوابة التكاملات الموحدة (/integrations) — بدون قيم حساسة
# انسخ هذا الملف إلى .env محليًا أو اضبط الأسرار في لوحة Render / Vercel / GitHub
# ==============================================================================

# --- 0) حراسة البوابة والخادم --------------------------------------------------
# ولّد قيمة عشوائية قوية (≥ 32 حرفًا): openssl rand -hex 32
WAHA_SECRET=
WAHA_OWNER_TOKEN=

# النطاقات المسموحة (CORS وHost Validation) — بدون مسار وبدون شرطة مائلة في النهاية
WAHA_ALLOWED_ORIGINS=https://sayedelazameydesign-crypto.github.io
WAHA_OWNER_ALLOWED_ORIGINS=
WAHA_TRUSTED_HOSTS=

# --- 1) تكامل GitHub Actions ---------------------------------------------------
# Fine-grained PAT بصلاحية Actions: Read and write فقط على المستودع المستهدف
GITHUB_TOKEN=
GITHUB_REPO=sayedelazameydesign-crypto/cela.ai
GITHUB_WORKFLOW_ID=ci.yml

# --- 2) تكامل Vercel -----------------------------------------------------------
# رمز قراءة فقط (Read-only token) لعرض سجل النشرات
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# رابط Deploy Hook للنشر (الرابط نفسه سرّ كتابة مستقل عن رمز القراءة)
DEPLOY_HOOK_URL=

# --- 3) تكامل Render -----------------------------------------------------------
# مفتاح API للقراءة فقط في البوابة، ومعرّف الخدمة (srv-...)
RENDER_API_KEY=
RENDER_SERVICE_ID=
# رابط Deploy Hook للنشر (يحتوي ?key= ويُحمَّر تلقائيًا في كل الردود)
RENDER_DEPLOY_HOOK_URL=

# --- 4) تكامل Google Drive -----------------------------------------------------
# المسار الدائم (موصى به للإنتاج): الثلاثي الكامل مع نطاقات drive.readonly + drive.file
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# المسار المؤقت للتجربة فقط (صالح ~60 دقيقة ولا يُجدَّد تلقائيًا):
GOOGLE_DRIVE_ACCESS_TOKEN=
# معرّف المجلد الافتراضي للتعداد والرفع (اختياري، ليس سرًّا)
GOOGLE_DRIVE_FOLDER_ID=

# --- 5) قاعدة البيانات ومزودات الذكاء الاصطناعي (اختياري) ---------------------
DATABASE_URL=
GEMINI_API_KEY=
